# ==========================================
# SURICATA HOST IDS
# Interface: enp1s0
# LAN: 192.168.2.0/24
# ==========================================

# ICMP detection
alert icmp any any -> $HOME_NET any (msg:"IDS - ICMP traffic detected"; sid:1000001; rev:1;)

# SSH connection attempts
alert tcp any any -> $HOME_NET 22 (msg:"IDS - SSH connection attempt"; flags:S; sid:1000002; rev:1;)

# Telnet connection attempts
alert tcp any any -> $HOME_NET 23 (msg:"IDS - Telnet connection attempt"; flags:S; sid:1000003; rev:1;)

# RDP connection attempts
alert tcp any any -> $HOME_NET 3389 (msg:"IDS - RDP connection attempt"; flags:S; sid:1000004; rev:1;)

# SMB connection attempts
alert tcp any any -> $HOME_NET 445 (msg:"IDS - SMB connection attempt"; flags:S; sid:1000005; rev:1;)

# DNS traffic
alert udp any any -> $HOME_NET 53 (msg:"IDS - DNS traffic detected"; sid:1000006; rev:1;)

