[Unit]
Description=Suricata AF_PACKET Intrusion Detection System
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=suricata-ids
Image=docker.io/jasonish/suricata:latest
Network=host

AddCapability=NET_ADMIN
AddCapability=NET_RAW
NoNewPrivileges=true

Volume=/var/lib/suricata-ids/config:/etc/suricata/custom:ro,Z
Volume=/var/lib/suricata-ids/rules:/etc/suricata/rules:ro,Z
Volume=suricata-ids-logs.volume:/var/log/suricata

Memory=2g
PodmanArgs=--cpus=1.5 --memory-reservation=768m --memory-swap=2g

Exec=-c /etc/suricata/custom/suricata.yaml --af-packet -l /var/log/suricata

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
