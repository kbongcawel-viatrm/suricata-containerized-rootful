# ========================================
# SURICATA LOCAL IDS RULES
# INTERFACE: enp1s0
# NFQUEUE: 0
# ========================================

alert icmp any any -> $HOME_NET any (
    msg:"IDS - ICMP traffic detected";
    sid:1000001;
    rev:1;
)

alert tcp any any -> $HOME_NET 22 (
    msg:"IDS - SSH connection attempt";
    flags:S;
    sid:1000002;
    rev:1;
)

alert tcp any any -> $HOME_NET 23 (
    msg:"IDS - Telnet connection attempt";
    flags:S;
    sid:1000003;
    rev:1;
)

alert tcp any any -> $HOME_NET 3389 (
    msg:"IDS - RDP connection attempt";
    flags:S;
    sid:1000004;
    rev:1;
)

alert tcp any any -> $HOME_NET 445 (
    msg:"IDS - SMB connection attempt";
    flags:S;
    sid:1000005;
    rev:1;
)

alert udp any any -> $HOME_NET 53 (
    msg:"IDS - DNS traffic detected";
    sid:1000006;
    rev:1;
)

